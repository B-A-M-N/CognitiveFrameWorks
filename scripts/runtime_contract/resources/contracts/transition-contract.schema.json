{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitivestatework.dev/schemas/transition-contract.schema.json",
  "type": "object",
  "required": ["version", "initial_state", "states", "completion_states", "normal_path", "transitions"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "initial_state": { "type": "string", "minLength": 1 },
    "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "completion_states": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "normal_path": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "external_entry_states": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "facts": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128 },
      "additionalProperties": {
        "type": "object",
        "properties": { "terminal_required": { "type": "boolean" } },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "trigger", "required_evidence", "work_class", "domain_effect", "progress_class"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "work_class": { "type": "string", "minLength": 1, "maxLength": 64 },
          "domain_effect": { "type": "string", "minLength": 1, "maxLength": 128 },
          "progress_class": { "enum": ["FORWARD_PROGRESS", "LATERAL", "RECOVERY", "INVALIDATION", "REGRESSION", "TERMINAL"] },
          "required_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "requires_facts": { "$ref": "#/$defs/fact_ids" },
          "establishes_facts": { "$ref": "#/$defs/fact_ids" },
          "invalidates_facts": { "$ref": "#/$defs/fact_ids" },
          "consequential": { "type": "boolean" },
          "path_class": { "enum": ["normal", "recovery", "failure", "invalidation", "external"] },
          "evidence_freshness": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["after_state_entry", "any"] },
              "max_age_seconds": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "fact_ids": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  },
  "additionalProperties": false
}
