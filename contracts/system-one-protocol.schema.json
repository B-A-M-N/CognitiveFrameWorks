{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitivestateframeworks.dev/contracts/system-one-protocol.schema.json",
  "title": "CFW System-1 protocol",
  "type": "object",
  "protocol_version": "2.1.0",
  "x-question-registry": {
    "action_relation": {
      "family": "action_relation",
      "type": "choice",
      "instructions": "How does the proposed action relate to the user's current objective and remaining acceptance criteria?",
      "criteria": {
        "advances_primary_goal": "Directly changes a deliverable or satisfies an unfinished acceptance criterion.",
        "removes_concrete_blocker": "Removes a specific obstacle preventing work on an unfinished criterion.",
        "required_verification": "Produces evidence needed to verify a requested criterion or recent artifact change.",
        "diagnostic_support": "Gathers information that may help choose a later action but does not itself advance or verify a criterion.",
        "unrelated": "Does not reasonably support the user's objective or its required verification."
      }
    },
    "progress_relation": {
      "family": "progress_relation",
      "type": "choice",
      "instructions": "What did the completed activity establish about the user's objective, using only the supplied host facts?",
      "criteria": {
        "goal_progress": "Host facts show a concrete change toward an identified unfinished criterion.",
        "blocker_removed": "Host facts show that a previously recorded blocker was removed.",
        "diagnostic_progress": "Host facts show relevant new information, without criterion-level progress.",
        "verification_progress": "Host facts show a criterion or artifact was actually checked.",
        "recovery_progress": "Host facts show a failed or invalid state was repaired.",
        "no_progress": "The supplied facts do not establish any of the above."
      }
    },
    "retry_relation": {
      "family": "retry_relation",
      "type": "choice",
      "instructions": "Compare the semantic descriptions of the previous failed approach and the proposed approach.",
      "criteria": {
        "materially_new": "The proposed approach uses a materially different causal hypothesis, mechanism, or evidence target.",
        "same_premise_new_action": "The underlying hypothesis is retained but the planned action or evidence target materially changes.",
        "equivalent_retry": "The proposed approach is semantically equivalent to an already failed approach despite wording or tool differences.",
        "unrelated": "The proposed approach does not address the recorded failure or cause."
      }
    },
    "goal_drift": {
      "family": "goal_drift",
      "type": "choice",
      "instructions": "Does the candidate activity appear unrelated to the unfinished objective or its necessary verification?",
      "criteria": {
        "yes": "The candidate appears to shift effort away from unfinished user criteria without a concrete dependency.",
        "no": "The candidate supports an unfinished criterion, its blocker, or needed verification."
      }
    },
    "route_preference": {
      "family": "route_preference",
      "type": "choice",
      "instructions": "Which already-authorized legal route best fits the current task state?",
      "criteria": {}
    }
  },
