        "application_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "application_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
