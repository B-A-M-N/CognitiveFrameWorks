{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://three-system.local/contracts/routing-experiment-plan.schema.json",
  "title": "Canonical routing experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "experiment_id", "candidate_profile_hash", "candidate_profile_id", "candidate_adjustment", "eligibility", "assignment_algorithm", "canary_fraction", "target_evaluator", "target_evaluator_version", "target_evaluator_hash", "control_policy_identity", "treatment_policy_identity", "holdout_requirements", "plan_hash"],
  "properties": {
    "plan_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "candidate_profile_hash": {"type": "string", "minLength": 1},
    "candidate_profile_id": {"type": "string", "minLength": 1},
    "candidate_adjustment": {"type": "object"},
    "eligibility": {"$ref": "#/$defs/condition"},
    "assignment_algorithm": {"const": "sha256(experiment_id + trial_identity)@v1"},
    "canary_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "target_evaluator": {"type": "string", "minLength": 1},
    "target_evaluator_version": {"type": "string", "minLength": 1},
    "target_evaluator_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_policy_identity": {"type": "string", "minLength": 1},
    "treatment_policy_identity": {"type": "string", "minLength": 1},
    "holdout_requirements": {
      "type": "object",
      "required": ["evaluators", "minimum_samples"],
      "properties": {
        "evaluators": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^.+@.+$"}},
        "minimum_samples": {"type": "integer", "minimum": 1},
        "holdout_task_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {"type": "object", "required": ["field", "equals"], "additionalProperties": false, "properties": {"field": {"type": "string", "minLength": 1}, "equals": {}, "contains": {"not": {}}}},
        {"type": "object", "required": ["field", "contains"], "additionalProperties": false, "properties": {"field": {"type": "string", "minLength": 1}, "equals": {"not": {}}, "contains": {}}},
        {"type": "object", "required": ["all"], "additionalProperties": false, "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}},
        {"type": "object", "required": ["any"], "additionalProperties": false, "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}}
      ]
    }
  }
}
