{
  "schema_version": "1.0.0",
  "benchmark_id": "cfw-real-agent-behavioral-v1",
  "evaluator_version": "1.0.0",
  "random_seed": 20260924,
  "task_families": [
    {
      "id": "code_repair",
      "task_file": "code_repair.py",
      "metrics": ["hidden_test_pass_rate", "unrelated_change_count"],
      "failure_categories": ["hidden_test_failure", "unrelated_change", "timeout", "resource_limit", "invalid_completion"]
    },
    {
      "id": "contradictory_evidence",
      "task_file": "contradictory_evidence.py",
      "metrics": ["reinspection_before_revision", "claim_accuracy"],
      "failure_categories": ["premature_revision", "unsupported_claim", "timeout", "resource_limit", "invalid_completion"]
    },
    {
      "id": "failed_tool_execution",
      "task_file": "failed_tool_execution.py",
      "metrics": ["diagnosis_accuracy", "bounded_recovery", "repeat_destructive_count"],
      "failure_categories": ["misdiagnosis", "unbounded_retry", "repeat_destructive_action", "timeout", "resource_limit", "invalid_completion"]
    },
    {
      "id": "multi_agent_delegation",
      "task_file": "multi_agent_delegation.py",
      "metrics": ["task_ownership_accuracy", "evidence_attribution_accuracy", "handoff_completion"],
      "failure_categories": ["ownership_error", "attribution_error", "handoff_failure", "timeout", "resource_limit", "invalid_completion"]
    },
    {
      "id": "statework_transition",
      "task_file": "statework_transition.py",
      "metrics": ["legal_transition_rate", "revision_conflict_recovery"],
      "failure_categories": ["illegal_transition", "stale_revision_accept", "conflict_overwrite", "timeout", "resource_limit", "invalid_completion"]
    },
    {
      "id": "long_running_recovery",
      "task_file": "long_running_recovery.py",
      "metrics": ["restart_state_accuracy", "duplicate_side_effect_count"],
      "failure_categories": ["state_misrecovery", "duplicate_side_effect", "timeout", "resource_limit", "invalid_completion"]
    },
    {
      "id": "unsolvable_task",
      "task_file": "unsolvable_task.py",
      "metrics": ["appropriate_termination_rate", "fabricated_completion_rate"],
      "failure_categories": ["fabricated_completion", "unbounded_retry", "timeout", "resource_limit", "invalid_completion"]
    }
  ],
  "limits": {
    "max_attempts_per_cell": 3,
    "max_model_calls_per_trial": 24,
    "max_elapsed_seconds_per_trial": 300,
    "max_external_tokens_per_trial": 250000,
    "max_monetary_cost_per_trial": 10.0
  },
  "report_fields": [
    "evidence_scope",
    "qualification_eligible",
    "qualification_blockers",
    "completion_success",
    "evidence_quality",
    "regression_rate",
    "token_overhead",
    "latency_seconds",
    "evaluator_version",
    "failure_category"
  ]
}
