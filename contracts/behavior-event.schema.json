{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalpsychology.dev/schemas/behavior-event.schema.json",
  "title": "DigitalPsychology behavioral event",
  "description": "Versioned schema for every behavioral telemetry event. Distinguishes the actor (who performed the event) from the behavioral subject (the agent whose behavior the event is evidence about). Compact, secret-safe envelope: payload is bounded metadata, never raw tool arguments/results.",
  "type": "object",
  "required": ["schema_version", "event_id", "timestamp", "agent_instance_id", "session_id", "task_id", "attempt_id", "segment_id", "agent_id", "behavioral_subject", "actor_id", "category", "event_type"],
  "properties": {
    "schema_version": { "const": "2.2.0" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "timestamp": { "type": "string", "format": "date-time" },
    "agent_instance_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "segment_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "agent_id": { "type": "string", "minLength": 1, "description": "Behavioral subject: the agent whose behavior this event is evidence about. For normal agent actions agent_id == actor_id." },
    "behavioral_subject": { "type": "string", "minLength": 1, "maxLength": 512, "description": "The task/object subject whose trajectory is being measured; distinct from the behavioral agent identity." },
    "actor_id": { "type": "string", "minLength": 1, "description": "Entity that produced/performed the event (operator, runtime, agent)." },
    "parent_event": { "type": ["string", "null"] },
    "category": { "enum": ["observation", "assumption", "inference", "decision", "action", "tool_result", "validation", "correction", "contradiction", "retry", "state_transition", "handoff", "completion", "blocker"] },
    "event_type": { "type": "string", "minLength": 1, "maxLength": 256 },
    "subject": { "type": ["string", "null"], "maxLength": 512 },
    "input_state": { "type": ["string", "null"] },
    "output_state": { "type": ["string", "null"] },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "uncertainty": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "authority_source": { "type": ["string", "null"] },
    "scope": { "type": ["string", "null"] },
    "supersedes": { "type": ["string", "null"] },
    "invalidates": { "type": ["string", "null"], "minLength": 1 },
    "interaction_id": { "type": ["string", "null"], "maxLength": 256 },
    "parent_session_id": { "type": ["string", "null"], "maxLength": 256 },
    "delegator_agent_id": { "type": ["string", "null"], "maxLength": 256 },
    "delegate_agent_id": { "type": ["string", "null"], "maxLength": 256 },
    "delegation_id": { "type": ["string", "null"], "maxLength": 256 },
    "role": { "type": ["string", "null"], "maxLength": 128 },
    "payload": {
      "type": "object",
      "description": "Bounded metadata: tool type, result class, evidence reference, exit state, bounded summary. Never full tool arguments or results; never secrets.",
      "properties": {
        "tool_type": { "type": "string", "maxLength": 64 },
        "result_class": { "type": "string", "maxLength": 64 },
        "evidence_reference": { "type": "string", "maxLength": 128 },
        "exit_state": { "type": "string", "maxLength": 64 },
        "summary": { "type": "string", "maxLength": 512 },
        "route": { "type": "string", "maxLength": 256 },
        "route_type": { "type": "string", "maxLength": 64 },
        "reason": { "type": "string", "maxLength": 128 },
        "outcome": { "enum": ["good", "bad"] },
        "policy_hash": { "type": "string", "maxLength": 128 },
        "routing_profile_hash": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "category": { "const": "completion" } }, "required": ["category"] },
      "then": { "required": ["evidence_refs"] }
    },
    {
      "if": { "properties": { "category": { "const": "contradiction" } }, "required": ["category"] },
      "then": { "required": ["invalidates"] }
    }
  ]
}
